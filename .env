ENV=development
API_PATH=https://dev.tourkokan.com/api/
API_PATH_ADMIN=https://dev.tourkokan.com/admin/
FTP_PATH=https://ftp.dev.tourkokan.com/
FTP_PATH1=https://dev.tourkokan.com
APP_URL=https://play.google.com/store/apps/details?id=com.tourkokan
GOOGLE_API=https://maps.googleapis.com/maps/api/geocode/json?address=
GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_MAPS_WEB_API_KEY
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID

