<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.GET_ACCOUNTS"/>
    <uses-permission android:name="android.permission.USE_CREDENTIALS"/>
    
    <!--
      android:enableOnBackInvokedCallback MUST stay false.
      Predictive back defaults to ON at targetSdk 36 (Android 16), and when it is on
      Android stops dispatching the legacy KEYCODE_BACK / Activity.onBackPressed().
      React Native 0.78 has no OnBackInvokedCallback support — ReactActivity routes
      hardware back only through onBackPressed() — so leaving it on silently kills
      EVERY JS BackHandler in the app and the device back button just closes the
      activity from any screen. Revisit only when RN ships predictive-back support.
    -->
    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false">

        <!-- ✅ Place meta-data tag HERE inside application -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCUUzdHc1ccGZhOzia9NoPf8mf3Yv901ZQ" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Link for referral invites. autoVerify makes Android
              fetch https://tourkokan.com/.well-known/assetlinks.json at install
              time and, if the SHA-256 there matches this build's signing cert,
              open these URLs directly in the app with no chooser dialog.
              If the file is missing or the fingerprint does not match, the link
              silently falls back to the browser — which is a safe degradation,
              and why the invite landing page has to exist either way.
              NOTE: with Play App Signing the fingerprint that must be in that
              file is Play's app signing key, not the upload key.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${deepLinkHost}"
                    android:pathPrefix="/invite" />
            </intent-filter>

            <!--
              Custom scheme. Requires no domain verification, so it works for
              testing before assetlinks.json is hosted. Not for sharing: it does
              nothing on a device without the app installed.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tourkokan" />
            </intent-filter>
        </activity>

    </application>

</manifest>
